---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={title} description={description} />
    </head>
    <body class="bg-black text-slate-50 antialiased min-h-screen">
        
        <div class="fixed inset-0 flex items-center justify-center pointer-events-none z-0">
            <div class="w-[70vw] h-[70vw] max-w-[800px] max-h-[800px] bg-white/[0.07] blur-[120px] sm:blur-[150px] rounded-full"></div>
        </div>

        <div class="relative z-10 flex flex-col min-h-screen">
            <Header />
            <main class="flex-grow w-full max-w-6xl mx-auto px-8 sm:px-12 lg:px-16 py-10">
                <slot />
            </main>
            <Footer />
        </div>
        
    </body>
</html>