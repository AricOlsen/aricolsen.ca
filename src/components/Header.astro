---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SocialBar from './SocialBar.astro';
---

<header class="w-full bg-black border-b border-neutral-800">
    <nav class="max-w-7xl mx-auto w-full px-8 sm:px-12 lg:px-16 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        
        <h2 class="text-xl font-bold text-white hover:scale-115 transition duration-300">
            <a href="/">{SITE_TITLE}</a>
        </h2>
        
        <div class="flex flex-row flex-wrap items-center justify-center gap-4 sm:gap-6 text-sm sm:text-base font-medium text-neutral-400">
            <HeaderLink href="/" class="hover:text-white transition">Home</HeaderLink>
            <HeaderLink href="/blog" class="hover:text-white transition">Blog</HeaderLink>
            <HeaderLink href="/tutoring" class="hover:text-white transition">Tutoring</HeaderLink>
            <HeaderLink href="/projects" class="hover:text-white transition">Projects</HeaderLink>
            <HeaderLink href="/running" class="hover:text-white transition">Running</HeaderLink>
            
            <div class="border-l border-neutral-600 pl-4 sm:pl-6">
                <SocialBar />
            </div>
        </div>

    </nav>
</header>