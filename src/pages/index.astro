---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hey there, I'm Aric!</h1>
			<p>
				This site is the hub for all of my pursuits. Whether you are brought here by my academic, professional, hobbyist,
				or personal roles, you have found the right place to access all things me!
			</p>
			<p>
				In case you haven't met me, or are looking for an update on what i've been up to, here are some of the roles I play 
				in our world:
			</p>
			<p>
				<code>Student: Aerospace Engineering (B.Eng)</code><br>
				<code>Tutor Math, Physics, Chemistry</code><br>	
				<code>Leader: Propulsion Project Manager (MetRocketry)</code><br>
			</p>
		</main>
		<Footer />
	</body>
</html>
