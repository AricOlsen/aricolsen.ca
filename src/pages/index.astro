---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialBar from '../components/SocialBar.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main>
		<div class="flex flex-col sm:flex-row 
				gap-8 
				border border-neutral-800 rounded-4xl 
				p-8 sm:p-12 mb-12 
				bg-black hover:border-neutral-50 
				text-center items-center" >
			<div class="w-32 h-32 sm:w-48 sm:h-48 rounded-full overflow-hidden">
					<img
					src="src\assets\AricPhoto1.JPG"
					alt="Photo of Aric Olsen"
					class="bg-white w-full h-full object-cover object-[1%_70%] rounded-full"
				/>
			</div>
			<div class="flex-grow flex flex-col gap-3">
                <h1 class="text-5xl sm:text-7xl font-extrabold tracking-tighter text-white tracking-wider">
                    Aric Olsen
                </h1>
				<span class="text-xl sm:text-1xl text-neutral-400 ">
					Academic | Tutor | Researcher | Runner | Leader | Brother | Son | Partner
				</span>
				<span class="text-xl sm:text-2xl text-neutral-400 mt-2">
					<SocialBar/>
				</span>
            </div>

		</div>
	</main>
</BaseLayout>
