---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';

const nextEvent = {
    title: 'Montreal Marathon 10k',
    date: '2026-10-10',
    location: 'Parc Maisonnevue, Montreal, QC',
    target: '<50:00',
};

const millisecondsUntilEvent = new Date(nextEvent.date).getTime() - Date.now();
const daysUntilEvent = Math.floor(millisecondsUntilEvent / (1000 * 60 * 60 * 24));
const hoursUntilEvent = Math.floor(millisecondsUntilEvent / (1000 * 60 * 60)) % 24;
const minutesUntilEvent = Math.floor(millisecondsUntilEvent / (1000 * 60)) % 60;
const secondsUntilEvent = Math.floor(millisecondsUntilEvent / 1000) % 60;
---
<BaseLayout>
    <div class="relative w-full rounded-2xl overflow-hidden bg-black p-8 min-h-[400px] flex flex-col justify-center">
        <img 
            src="https://couronsmtl.com/wp-content/uploads/2024/09/Rectangle-1.png" 
            alt="Montreal Marathon Logo" 
            class="absolute inset-0 w-full h-full object-cover opacity-40 z-0" 
        />

        <div class="relative z-10">
            <h1 class="text-4xl font-bold mb-4 text-slate-50">Next Race</h1>
            <h2 class="text-2xl font-semibold mb-8 text-slate-50">{nextEvent.title}</h2>
            
            <div id="countdown" data-event-date={nextEvent.date} class="flex flex-row justify-start items-center space-x-4 sm:space-x-6 text-slate-50 mb-8">
                <div class="flex flex-col border border-neutral-50 rounded-lg p-2 bg-black/40 backdrop-blur-sm"><span id="days" class="sm:text-6xl text-3xl font-black">{daysUntilEvent}</span><span class="text-sm text-slate-300">Days</span></div>
                <div class="flex flex-col border border-neutral-50 rounded-lg p-2 bg-black/40 backdrop-blur-sm"><span id="hours" class="sm:text-6xl text-3xl font-black">{String(hoursUntilEvent).padStart(2, '0')}</span><span class="text-sm text-slate-300">Hours</span></div>
                <div class="flex flex-col border border-neutral-50 rounded-lg p-2 bg-black/40 backdrop-blur-sm"><span id="minutes" class="sm:text-6xl text-3xl font-black">{String(minutesUntilEvent).padStart(2, '0')}</span><span class="text-sm text-slate-300">Mins</span></div>
                <div class="flex flex-col border border-neutral-50 rounded-lg p-2 bg-black/40 backdrop-blur-sm"><span id="seconds" class="sm:text-6xl text-3xl font-black">{String(secondsUntilEvent).padStart(2, '0')}</span><span class="text-sm text-slate-300">Secs</span></div>
            </div>
            
            <p class="mb-1 text-slate-50 font-medium">Location: {nextEvent.location}</p>
            <p class="mb-1 text-slate-50 font-medium">Target Time: {nextEvent.target}</p>
        </div>
    </div>
</BaseLayout>

<script>
    const countdown = document.querySelector<HTMLElement>('#countdown');

    if (countdown) {
        const eventDate = countdown.dataset.eventDate;
        const days = document.querySelector<HTMLElement>('#days');
        const hours = document.querySelector<HTMLElement>('#hours');
        const minutes = document.querySelector<HTMLElement>('#minutes');
        const seconds = document.querySelector<HTMLElement>('#seconds');

        const updateCountdown = () => {
            if (!eventDate || !days || !hours || !minutes || !seconds) return;

            const millisecondsUntilEvent = Math.max(0, new Date(`${eventDate}T00:00:00`).getTime() - Date.now());
            days.textContent = String(Math.floor(millisecondsUntilEvent / (1000 * 60 * 60 * 24)));
            hours.textContent = String(Math.floor(millisecondsUntilEvent / (1000 * 60 * 60)) % 24).padStart(2, '0');
            minutes.textContent = String(Math.floor(millisecondsUntilEvent / (1000 * 60)) % 60).padStart(2, '0');
            seconds.textContent = String(Math.floor(millisecondsUntilEvent / 1000) % 60).padStart(2, '0');
        };

        updateCountdown();
        setInterval(updateCountdown, 1000);
    }
</script>